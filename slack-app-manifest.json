{
  "display_information": {
    "name": "MAG chat",
    "description": "Еженедельные и ежемесячные механики для вовлечения команды",
    "background_color": "#4A154B"
  },
  "features": {
    "bot_user": {
      "display_name": "MAG chat",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "chat:write.public",
        "reactions:write",
        "channels:read",
        "groups:read",
        "users:read"
      ]
    }
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
